// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  searchHistory SearchHistory[]
  favorites     Favorite[]
  quizScores    QuizScore[]
  preferences   UserPreferences?

  @@map("users")
}

model SearchHistory {
  id         String   @id @default(cuid())
  userId     String
  term       String
  definition Json     // Store the full SlangDefinition object
  timestamp  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_history")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  term       String
  definition Json     // Store the full SlangDefinition object
  savedAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, term])
  @@map("favorites")
}

model QuizScore {
  id     String   @id @default(cuid())
  userId String
  score  Int
  total  Int
  date   DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_scores")
}

model UserPreferences {
  id                String   @id @default(cuid())
  userId            String   @unique
  autoSpeak         Boolean  @default(true)
  speechRate        Float    @default(1.0)
  speechVoice       String   @default("default")
  theme             String   @default("dark")
  showHistory       Boolean  @default(true)
  showFavorites     Boolean  @default(true)
  lastWordOfDay     String   @default("")
  lastWordOfDayDate String   @default("")
  searchCount       Int      @default(0)
  favoriteCount     Int      @default(0)
  quizHighScore     Int      @default(0)
  totalQuizAttempts Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model WordOfTheDay {
  id          String   @id @default(cuid())
  word        String   @unique
  definition  Json     // Store the full SlangDefinition object
  date        DateTime @default(now())
  isActive    Boolean  @default(true)

  @@map("word_of_the_day")
}